# Copy to .env for local development. Never commit real credentials.
APP_ENV=local
DATABASE_URL=postgresql://autograph:local_only@localhost:5432/autograph
TEST_DATABASE_URL=postgresql://autograph_test:local_test_only@localhost:5433/autograph_test
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
# Reserved for the later object-storage integration; no operations use it yet.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=autographs-local
