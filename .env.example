# Copy to .env for local development. Never commit real credentials.
APP_ENV=local
DATABASE_URL=postgresql://autograph:local_only@localhost:5432/autograph
TEST_DATABASE_URL=postgresql://autograph_test:local_test_only@localhost:5433/autograph_test
API_HOST=127.0.0.1
API_PORT=4000
SESSION_TTL_SECONDS=1209600
TRUSTED_WEB_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:4000
WEB_ORIGIN=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/auth/google/callback
TELEGRAM_CLIENT_ID=replace-with-telegram-client-id
TELEGRAM_CLIENT_SECRET=replace-with-telegram-client-secret
TELEGRAM_REDIRECT_URI=http://127.0.0.1:4000/auth/telegram/callback
API_INTERNAL_URL=http://127.0.0.1:4000
# Local-only MinIO credentials match compose.yaml. Use environment credentials or IAM in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=autographs-local
S3_ACCESS_KEY_ID=local_minio
S3_SECRET_ACCESS_KEY=local_minio_password
UPLOAD_URL_TTL_SECONDS=300
PREVIEW_URL_TTL_SECONDS=120
WORKER_POLL_INTERVAL_MS=1000
WORKER_LEASE_SECONDS=300
UPLOAD_CLEANUP_GRACE_SECONDS=600
