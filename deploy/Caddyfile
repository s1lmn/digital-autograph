{
  servers {
    max_header_size 32KB
    timeouts {
      read_header 10s
      read_body 35s
      write 45s
      idle 60s
    }
  }
}

{$WEB_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 10485760
  }
  reverse_proxy web:3000
}

{$API_DOMAIN} {
  encode zstd gzip
  request_body {
    max_size 10485760
  }
  reverse_proxy api:4000 {
    transport http {
      dial_timeout 5s
      response_header_timeout 40s
    }
  }
}
