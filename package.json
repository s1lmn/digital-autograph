{
  "name": "digital-autograph-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "dotenv -e .env -- concurrently -k -n api,worker,web \"pnpm --filter @digital-autograph/api dev\" \"pnpm --filter @digital-autograph/worker dev\" \"pnpm --filter @digital-autograph/web dev\"",
    "build": "dotenv -e .env -- pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "dotenv -e .env -- node scripts/run-integration.mjs",
    "test:build-smoke": "dotenv -e .env -- node scripts/smoke-built-api.mjs",
    "db:migrate": "dotenv -e .env -- pnpm --filter @digital-autograph/db db:migrate",
    "db:generate": "dotenv -e .env -- pnpm --filter @digital-autograph/db db:generate",
    "infra:up": "docker compose up -d",
    "infra:test:up": "docker compose --profile test up -d postgres-test",
    "infra:down": "docker compose --profile test down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "sharp": "0.35.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
