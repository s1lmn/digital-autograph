{
  "name": "digital-autograph-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "brand:export": "node scripts/brand-kit.mjs",
    "brand:check": "node scripts/brand-kit.mjs --check",
    "dev": "dotenv -e .env -- concurrently -k -n api,worker,web \"pnpm --filter @digital-autograph/api dev\" \"pnpm --filter @digital-autograph/worker dev\" \"pnpm --filter @digital-autograph/web dev\"",
    "build": "dotenv -e .env -- pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json && tsc -p tsconfig.e2e.json && tsc -p tsconfig.load-test.json",
    "load:public-wall": "node apps/api/scripts/public-wall-load.ts",
    "test": "vitest run --config vitest.config.ts",
    "security:audit": "pnpm audit --audit-level high",
    "test:integration": "dotenv -e .env -- node scripts/run-integration.mjs",
    "test:build-smoke": "dotenv -e .env -- node scripts/smoke-built-api.mjs",
    "test:runner-authorization": "node scripts/smoke-runner-authorization.mjs",
    "test:migration-image": "node scripts/smoke-migration-image.mjs",
    "e2e:setup": "tsx apps/api/scripts/e2e-setup.ts",
    "test:e2e": "playwright test",
    "db:migrate": "dotenv -e .env -- pnpm --filter @digital-autograph/db db:migrate",
    "db:generate": "dotenv -e .env -- pnpm --filter @digital-autograph/db db:generate",
    "infra:up": "docker compose up -d",
    "infra:e2e:up": "docker compose --profile e2e up -d postgres-e2e minio-e2e",
    "infra:e2e:down": "docker compose --profile e2e rm --stop --force postgres-e2e minio-e2e",
    "infra:test:up": "docker compose --profile test up -d postgres-test",
    "infra:down": "docker compose --profile test down",
    "payments:reconcile": "dotenv -e .env -- tsx apps/api/src/payments/reconcile.ts",
    "test:portable": "vitest run --config vitest.portable.config.ts",
    "test:posix": "vitest run --config vitest.posix.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.0",
    "sharp": "0.35.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0"
  }
}
